# ============================================
# Eleven Blog Docker Compose environment
# Copy to .env when using docker compose.
# For local development use blog-view/.env.example.
# ============================================

BLOG_PORT=8080

# Optional GitHub content source used during the image build.
# Leave empty when blog-view/notes/ is available.
GITHUB_CONTENT_OWNER=
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_ROOT=
GITHUB_CONTENT_TOKEN=
