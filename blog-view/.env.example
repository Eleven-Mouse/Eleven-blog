# ============================================
# Eleven Blog static build environment
# Copy to .env.local for local development.
# ============================================

# Use build-time static data in the browser.
VITE_CONTENT_SOURCE=static

# Giscus comments
VITE_GISCUS_REPO=Eleven-Mouse/Eleven-blog
VITE_GISCUS_REPO_ID=R_kgDOQxLe7w
VITE_GISCUS_CATEGORY=Announcements
VITE_GISCUS_CATEGORY_ID=DIC_kwDOQxLe784DGJ97
VITE_GISCUS_MAPPING=pathname

# Optional Giscus overrides
VITE_GISCUS_STRICT=0
VITE_GISCUS_REACTIONS_ENABLED=1
VITE_GISCUS_EMIT_METADATA=0
VITE_GISCUS_INPUT_POSITION=bottom
VITE_GISCUS_LANG=zh-CN

# Optional GitHub content source.
# Local notes/ takes precedence when it contains Markdown files.
# GITHUB_CONTENT_TOKEN is build-only and must never use the VITE_ prefix.
GITHUB_CONTENT_OWNER=
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=main
GITHUB_CONTENT_ROOT=
GITHUB_CONTENT_TOKEN=

# Optional site configuration injected during the build.
BLOG_STATIC_CONFIG_JSON='{"blog_name":"Eleven Blog","blog_bio":"记录学习与实践","blog_github_url":"https://github.com/Eleven-Mouse"}'
